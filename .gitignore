/media_downloads/

# AI26 helper scripts are public, but local exports and collector by-products
# created beside them are not.
/ai26_runtime/*.jsonl
/ai26_runtime/*.csv
/ai26_runtime/*.log
/ai26_runtime/*.pid
/ai26_runtime/*.session*

# Common runtime research databases / media artifacts.
# If a small binary fixture is ever genuinely required, keep it in a clearly
# synthetic test-fixture directory and add a narrowly scoped exception after
# publication-safety review rather than weakening these defaults.
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.duckdb
*.db
*.db-*
*.bson
*.rdb
*.aof
*.dump
*.backup
*.bak
*.parquet
*.mp4
*.mov
*.avi
*.mkv
*.wav
*.mp3
*.m4a

# Compressed archives are a common accidental route for database dumps, raw
# captures and exports. Track a reviewed release artifact explicitly if needed.
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

