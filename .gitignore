# Cursor
.cursorignore
.cursorindexingignore

# Research data roots are never committed, but the directory READMEs are
# tracked so the convention ships with the repo. Ignore the *contents* (/*)
# instead of the directory itself, or git cannot re-include anything under it.
/sources/*
/data/*
!/sources/README.md
!/data/README.md

# EP24 codebooks are public research-method artifacts. Their publication is
# governed by docs/DATA_PUBLICATION_POLICY.md; subject-level inferred
# attributes must never be added here.
!/sources/codebooks/
!/sources/codebooks/*.md

# LaclauGPT collector runtime data roots
laclaugpt-brasil-data/
collection-data/
*.har

# Explicit EP24 runtime inputs (redundant with /data/*, kept as defence in depth)
data/csv/ep24_poland.csv
data/csv/ep24_finland.csv
/.venv-ep24

