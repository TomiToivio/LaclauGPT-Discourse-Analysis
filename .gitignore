# Private operational collection settings.
# Public collector configs must be templates/synthetic examples or an explicitly
# reviewed reproducibility exception. Real Telegram/RSS/web watch lists and
# study-specific source selection belong outside Git by default.
collector/config/*.private.yaml
collector/config/*.local.yaml
collector/config/*-operational.yaml
collector/config/*-live.yaml
collector/config/telegram.yaml
collector/config/rss.yaml
collector/config/web.yaml
collector/config/collection-sources.yaml
collector/config/live-sources.yaml
collector/config/brazil-election-2026.yaml
collector/browser-profiles/
collector/browser_profiles/
collector/firefox/profiles/

# Host-specific deployment notes and private deployment overlays stay outside
# the public repository. Public deploy/ files must remain portable templates.
docs/DEPLOYMENT_*_LOCAL.md
docs/DEPLOYMENT_LASKIN_AI26.md
deploy/**/*.private.*
deploy/**/*.local.*

# Explicit restricted research roots
/private_data/
/restricted/
/scratch/

