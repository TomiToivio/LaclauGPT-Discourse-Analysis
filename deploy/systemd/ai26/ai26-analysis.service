# Generic systemd user-unit example. Keep host-specific overrides outside Git.
[Unit]
Description=LaclauGPT incremental analysis tick

[Service]
Type=oneshot
WorkingDirectory=%h/src/LaclauGPT-Discourse-Analysis
ExecStart=/usr/bin/python3 ai26_runtime/analysis_worker.py
Environment=OLLAMA_KEEP_ALIVE=24h
Environment=AI26_BATCH=6
StandardOutput=append:%h/.local/state/laclaugpt/analysis.log
StandardError=append:%h/.local/state/laclaugpt/analysis.log
