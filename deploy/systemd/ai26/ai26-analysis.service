# Example systemd user unit (Laskin01 deployment; paths/host are environment-specific).
[Unit]
Description=AI26 incremental analysis tick (local gemma4 via stage routing)

[Service]
Type=oneshot
WorkingDirectory=/mnt/workspace/LaclauGPT-Discourse-Analysis
ExecStart=/usr/bin/python3 /mnt/workspace/LaclauGPT-Discourse-Analysis/ai26_runtime/analysis_worker.py
# keep all gemma4 tiers resident across stage rotation (3x V100 = 96 GB)
Environment=OLLAMA_KEEP_ALIVE=24h
Environment=AI26_BATCH=6
StandardOutput=append:%h/.config/laclaugpt/ai26/analysis.log
StandardError=append:%h/.config/laclaugpt/ai26/analysis.log