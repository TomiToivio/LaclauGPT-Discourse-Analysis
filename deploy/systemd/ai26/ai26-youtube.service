# Example systemd user unit (Laskin01 deployment; paths/host are environment-specific).
[Unit]
Description=AI26 YouTube channel RSS collection
After=network-online.target mongodb.service

[Service]
Type=oneshot
WorkingDirectory=/mnt/workspace/LaclauGPT-Discourse-Analysis/ai26_runtime
ExecStart=/usr/bin/python3 /mnt/workspace/LaclauGPT-Discourse-Analysis/ai26_runtime/collect_youtube_loop.py
StandardOutput=append:%h/.config/laclaugpt/ai26/youtube.log
StandardError=append:%h/.config/laclaugpt/ai26/youtube.log
