# Example systemd user unit (Laskin01 deployment; paths/host are environment-specific).
[Unit]
Description=AI26 Telegram bridge (vasama_ai.events -> ai26_sources)

[Service]
Type=oneshot
WorkingDirectory=/mnt/workspace/LaclauGPT-Discourse-Analysis/ai26_runtime
ExecStart=/usr/bin/python3 /mnt/workspace/LaclauGPT-Discourse-Analysis/ai26_runtime/telegram_bridge.py
StandardOutput=append:%h/.config/laclaugpt/ai26/telegram.log
StandardError=append:%h/.config/laclaugpt/ai26/telegram.log
