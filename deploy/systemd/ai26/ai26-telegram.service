# Example systemd user unit (DEPLOYMENT_HOST deployment; paths/host are environment-specific).
[Unit]
Description=AI26 Telegram bridge (laclaugpt_ai26.events -> ai26_sources)

[Service]
Type=oneshot
WorkingDirectory=LACLAUGPT_REPO_ROOT/ai26_runtime
ExecStart=/usr/bin/python3 LACLAUGPT_REPO_ROOT/ai26_runtime/telegram_bridge.py
StandardOutput=append:%h/.config/laclaugpt/ai26/telegram.log
StandardError=append:%h/.config/laclaugpt/ai26/telegram.log
