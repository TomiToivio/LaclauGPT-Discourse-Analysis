# Generic systemd user-unit example. Keep host-specific overrides outside Git.
[Unit]
Description=LaclauGPT dashboard JSONL export

[Service]
Type=oneshot
WorkingDirectory=%h/src/LaclauGPT-Discourse-Analysis
ExecStartPre=/bin/sh -c 'for f in collection-data/dashboard/*.jsonl; do [ -e "$f" ] && : > "$f"; done; true'
ExecStart=/usr/bin/python3 ai26_runtime/export_dashboard_jsonl.py
StandardOutput=append:%h/.local/state/laclaugpt/export.log
StandardError=append:%h/.local/state/laclaugpt/export.log
