# Example systemd user unit (Laskin01 deployment; paths/host are environment-specific).
[Unit]
Description=AI26 RSS collection tick
After=network-online.target mongodb.service

[Service]
Type=oneshot
WorkingDirectory=/mnt/workspace/LaclauGPT-Discourse-Analysis/ai26_runtime
ExecStart=/usr/bin/python3 /mnt/workspace/LaclauGPT-Discourse-Analysis/ai26_runtime/collect_rss_loop.py
StandardOutput=append:%h/.config/laclaugpt/ai26/rss.log
StandardError=append:%h/.config/laclaugpt/ai26/rss.log
