# Example systemd user unit (DEPLOYMENT_HOST deployment; paths/host are environment-specific).
[Unit]
Description=AI26 RSS collection tick
After=network-online.target mongodb.service

[Service]
Type=oneshot
WorkingDirectory=LACLAUGPT_REPO_ROOT/ai26_runtime
ExecStart=/usr/bin/python3 LACLAUGPT_REPO_ROOT/ai26_runtime/collect_rss_loop.py
StandardOutput=append:%h/.config/laclaugpt/ai26/rss.log
StandardError=append:%h/.config/laclaugpt/ai26/rss.log
