# Generic systemd user-unit example. Keep host-specific overrides outside Git.
[Unit]
Description=LaclauGPT RSS collection tick
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/src/LaclauGPT-Discourse-Analysis/ai26_runtime
ExecStart=/usr/bin/python3 collect_rss_loop.py
StandardOutput=append:%h/.local/state/laclaugpt/rss.log
StandardError=append:%h/.local/state/laclaugpt/rss.log
