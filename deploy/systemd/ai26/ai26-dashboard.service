# Generic systemd user-unit example. Keep host-specific overrides outside Git.
[Unit]
Description=LaclauGPT Streamlit dashboard

[Service]
Type=simple
WorkingDirectory=%h/src/LaclauGPT-Discourse-Analysis
ExecStart=/usr/bin/python3 -m laclaugpt.cli dashboard collection-data/dashboard/elites.jsonl --project ai26 --arena elites --host 127.0.0.1 --port 8502
Restart=on-failure
RestartSec=30
StandardOutput=append:%h/.local/state/laclaugpt/dashboard.log
StandardError=append:%h/.local/state/laclaugpt/dashboard.log
