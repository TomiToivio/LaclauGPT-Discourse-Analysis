# Example systemd user unit (Laskin01 deployment; paths/host are environment-specific).
[Unit]
Description=AI26 Streamlit dashboard (Mongo-exported canonical annotations)

[Service]
Type=simple
WorkingDirectory=/mnt/workspace/LaclauGPT-Discourse-Analysis
ExecStart=/usr/bin/python3 -m laclaugpt.cli dashboard collection-data/dashboard/elites.jsonl --project ai26 --arena elites --host 127.0.0.1 --port 8502
Restart=on-failure
RestartSec=30
StandardOutput=append:%h/.config/laclaugpt/ai26/dashboard.log
StandardError=append:%h/.config/laclaugpt/ai26/dashboard.log